{
  "name": "matryoshka-rlm",
  "version": "0.2.38",
  "type": "module",
  "description": "Recursive Language Model - Process documents larger than LLM context windows",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "rlm": "dist/index.js",
    "rlm-mcp": "dist/mcp-server.js",
    "lattice-mcp": "dist/lattice-mcp-server.js",
    "lattice-repl": "dist/repl/lattice-repl.js",
    "lattice-pipe": "dist/tool/adapters/pipe.js",
    "lattice-http": "dist/tool/adapters/http.js",
    "lattice-setup": "dist/scripts/setup-claude-code.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./rlm": {
      "types": "./dist/rlm.d.ts",
      "default": "./dist/rlm.js"
    },
    "./server": {
      "types": "./dist/mcp-server.d.ts",
      "default": "./dist/mcp-server.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./repl": {
      "types": "./dist/repl/index.d.ts",
      "default": "./dist/repl/index.js"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "default": "./dist/tool/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "config.example.json"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mcp": "tsx src/mcp-server.ts",
    "repl": "tsx src/repl/lattice-repl.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "keywords": [
    "llm",
    "rlm",
    "mcp",
    "claude",
    "document-analysis",
    "recursive",
    "context-window",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yogthos/Matryoshka.git"
  },
  "homepage": "https://github.com/yogthos/Matryoshka#readme",
  "bugs": {
    "url": "https://github.com/yogthos/Matryoshka/issues"
  },
  "author": "yogthos",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tree-sitter-grammars/tree-sitter-markdown": "^0.3.2",
    "@types/sql.js": "^1.4.11",
    "@vscode/tree-sitter-wasm": "^0.3.0",
    "@yogthos/tree-sitter-clojure": "^0.0.14",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-dag": "^0.4.1",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "graphology-types": "^0.24.8",
    "matryoshka-rlm": "^0.2.5",
    "ramo": "^0.1.2",
    "repl-sandbox": "^0.1.1",
    "sql.js": "^1.14.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-css": "^0.21.1",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
